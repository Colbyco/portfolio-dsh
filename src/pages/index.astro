---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { entries, FEATURED, MODE_LABEL, impact, skills, coreStack, type Entry } from "../data/projects";

const featured = entries.find((e) => e.slug === FEATURED)!;
const main = entries.filter((e) => e.tier === "main");
const school = entries.filter((e) => e.tier === "school");
const careers = entries.filter((e) => e.kind === "career");
const projects = entries.filter((e) => e.kind === "project" && e.tier === "main");

/** Every technology for an entry, key ones first, no duplicates. */
const allTech = (e: Entry) => [...new Set([...e.keyTech, ...e.tech.flatMap((g) => g.items)])];
const shortTitle = (e: Entry) => e.title.replace(", CVS Health", "");
const where = (e: Entry) => (e.kind === "career" ? "CVS Health" : e.tier === "school" ? "School project" : "Personal project");

// Payload for the client script (kept small: no long copy).
const stageData = entries.map((e) => ({
  slug: e.slug,
  title: shortTitle(e),
  kind: e.kind,
  tier: e.tier,
  mode: e.preview.mode,
  modeLabel: MODE_LABEL[e.preview.mode],
  url: e.preview.url ?? null,
  stampNow: e.preview.stampNow ?? null,
  address: e.preview.address,
  routes: e.preview.routes ?? null,
}));
---
<Base
  title="Colby Baker · Software Engineer"
  description="Software engineer at CVS Health building backend APIs and LLM systems for healthcare. Projects run live on the page: Aspicio, Spotify Classic Lyrics and more, with the stack behind each one."
>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <span class="monogram" aria-hidden="true">CB</span>
        <span class="brand-name">Colby Baker</span>
      </a>
      <nav class="toplinks" aria-label="Profiles and resume">
        <a href="/Colby-Baker-Resume.pdf"><Icon name="file" /><span>Resume</span></a>
        <a href="https://github.com/Colbyco" rel="me"><Icon name="github" /><span>GitHub</span></a>
        <a href="https://www.linkedin.com/in/bakercolby/" rel="me"><Icon name="linkedin" /><span>LinkedIn</span></a>
        <button class="icon-btn theme-toggle" type="button" aria-label="Color theme: system" data-theme-toggle>
          <Icon name="theme" size={18} />
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="intro" aria-labelledby="intro-name">
      <div class="intro-id">
        <h1 id="intro-name">Colby Baker</h1>
        <p class="lede">
          Software engineer at <strong>CVS Health</strong>: backend APIs and LLM systems for healthcare.
          On my own time I ship products end to end, like <a href="#aspicio" data-select="aspicio">Aspicio</a>.
        </p>
        <p class="intro-meta">Seattle, WA · B.S. Computer Science, Florida State University</p>
        <ul class="core-stack" aria-label="Core stack">
          {coreStack.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
      <ul class="impact" aria-label="Impact at CVS Health">
        {impact.map((m) => (
          <li><span class="impact-value">{m.value}</span><span class="impact-label">{m.label}</span></li>
        ))}
      </ul>
    </section>

    <section class="theater" id="theater" aria-label="Work and projects, each with a live preview">
      <nav class="rail" aria-labelledby="rail-title">
        <div class="rail-head">
          <h2 id="rail-title">Work and projects</h2>
          <span class="rail-span">newest first</span>
        </div>
        <div class="rail-list" role="tablist" aria-orientation="vertical" aria-label={`${entries.length} projects and roles, newest first`}>
          {main.map((e) => (
            <button
              class:list={["rail-item", `kind-${e.kind}`, `mode-${e.preview.mode}`]}
              type="button"
              role="tab"
              id={`tab-${e.slug}`}
              aria-controls="stage-panel"
              aria-selected={e.slug === FEATURED ? "true" : "false"}
              tabindex={e.slug === FEATURED ? 0 : -1}
              data-slug={e.slug}
            >
              <span class="rail-dot" aria-hidden="true"></span>
              <span class="rail-date">{e.date}</span>
              <span class="rail-title">{e.railTitle ?? e.title}</span>
              <span class="rail-tech" aria-label="Stack">{e.keyTech.map((t) => <span class="mini-tag">{t}</span>)}</span>
            </button>
          ))}
          <div class="rail-group" data-rail-group>
            <button type="button" class="rail-group-toggle" aria-expanded="false" aria-controls="rail-school" data-rail-toggle>
              <span>School projects</span><span class="rail-count">{school.length}</span>
            </button>
            <div class="rail-group-items" id="rail-school" data-rail-items hidden>
            {school.map((e) => (
              <button
                class:list={["rail-item", `kind-${e.kind}`, `mode-${e.preview.mode}`]}
                type="button"
                role="tab"
                id={`tab-${e.slug}`}
                aria-controls="stage-panel"
                aria-selected="false"
                tabindex="-1"
                data-slug={e.slug}
              >
                <span class="rail-dot" aria-hidden="true"></span>
                <span class="rail-date">{e.date}</span>
                <span class="rail-title">{e.railTitle ?? e.title}</span>
                <span class="rail-tech" aria-label="Stack">{e.keyTech.map((t) => <span class="mini-tag">{t}</span>)}</span>
              </button>
            ))}
            </div>
          </div>
        </div>
      </nav>

      <div class="stage-col" role="tabpanel" id="stage-panel" aria-labelledby={`tab-${FEATURED}`}>
        <div class="frame" data-frame>
          <div class="frame-bar">
            <span class="frame-mode" data-badge>{MODE_LABEL[featured.preview.mode]}</span>
            <span class="frame-address" data-address>
              <span data-address-text>{featured.preview.address}</span>
            </span>
            <span class="frame-actions">
              <button class="icon-btn" type="button" data-expand aria-label="Full screen preview" title="Full screen"><Icon name="expand" /></button>
              <a class="icon-btn" data-open href={featured.preview.url} target="_blank" rel="noopener" aria-label="Open preview in a new tab" title="Open in a new tab"><Icon name="external" /></a>
            </span>
          </div>
          <div class="route-bar" data-routes role="toolbar" aria-label="Pages in this preview" hidden></div>
          <div class="frame-view" data-view>
            <img class="poster" data-poster alt="" width="1280" height="860" sizes="(max-width: 1099px) 100vw, 56vw" decoding="async" hidden />
            {careers.map((e) => (
              <div class="career-card" data-career={e.slug} hidden>
                <p class="career-kicker"><Icon name="briefcase" size={14} /> {e.date} · CVS Health · internal work</p>
                <h3 class="career-title">{shortTitle(e)}</h3>
                <p class="career-summary">{e.summary}</p>
                <ul class="career-metrics">
                  {e.metrics?.map((m) => <li><span class="cm-value">{m.value}</span><span class="cm-label">{m.label}</span></li>)}
                </ul>
                <ul class="career-stack" aria-label="Stack">{allTech(e).map((t) => <li class="tag">{t}</li>)}</ul>
              </div>
            ))}
            <div class="loading" data-loading hidden>
              <span class="spinner" aria-hidden="true"></span>
              <p data-loading-text>Loading preview…</p>
              <p class="loading-slow" data-loading-slow hidden>
                This is taking a while.
                <button type="button" class="link-btn" data-retry>Try again</button>
                or <a data-loading-open href="#" target="_blank" rel="noopener">open it in a new tab</a>.
              </p>
            </div>
            <noscript>
              <p class="noscript-note">Live previews need JavaScript. Every project's links still work in the panel beside this one.</p>
            </noscript>
          </div>
        </div>
        <div class="stage-nav">
          <button class="nav-btn" type="button" data-prev><Icon name="prev" /><span data-prev-label>Newer</span></button>
          <button class="nav-btn" type="button" data-next><span data-next-label>Older</span><Icon name="next" /></button>
        </div>
      </div>

      <aside class="details" aria-label="Project details">
        {entries.map((e) => (
          <article class="detail" data-detail={e.slug} id={e.slug} hidden={e.slug !== FEATURED}>
            <p class="detail-when"><span class="when-date">{e.date}</span><span class="when-sep" aria-hidden="true">·</span><span class="when-where">{where(e)}</span></p>
            <h2 class="detail-title">{shortTitle(e)}</h2>
            <ul class="detail-tech" aria-label="Stack">
              {allTech(e).map((t) => <li class="tag">{t}</li>)}
            </ul>
            <p class="detail-summary">{e.summary}</p>
            <h3 class="detail-h">{e.kind === "career" ? "What I did" : "What I built"}</h3>
            <ul class="detail-built">
              {e.built.map((b) => <li>{b}</li>)}
            </ul>
            {e.links.length > 0 && (
              <p class="detail-links">
                {e.links.map((l) => (
                  <a class="link-pill" href={l.href} target="_blank" rel="noopener">{l.label}<Icon name="external" size={13} /></a>
                ))}
              </p>
            )}
          </article>
        ))}
      </aside>
    </section>

    <section class="projects" aria-labelledby="projects-title">
      <div class="section-inner">
        <h2 id="projects-title" class="section-title">Projects</h2>
        <ul class="project-grid">
          {projects.map((e) => (
            <li class="project-card">
              <p class="card-when">{e.date}</p>
              <h3 class="card-title"><a href={`#${e.slug}`} data-select={e.slug}>{e.title}</a></h3>
              <p class="card-line">{e.summary}</p>
              <ul class="card-tech" aria-label="Stack">{e.keyTech.map((t) => <li class="tag">{t}</li>)}</ul>
              <p class="card-links">
                <button type="button" class="link-pill" data-select={e.slug}><Icon name="play" size={12} />Preview</button>
                {e.links.map((l) => (
                  <a class="link-pill" href={l.href} target="_blank" rel="noopener">{l.label}<Icon name="external" size={13} /></a>
                ))}
              </p>
            </li>
          ))}
        </ul>
        <p class="school-line">
          <strong>School projects (2021–2024):</strong>
          {school.map((e, i) => (
            <span class="school-item">
              <a href={`#${e.slug}`} data-select={e.slug}>{e.railTitle ?? e.title}</a>
              <span class="school-tech"> · {e.keyTech.slice(0, 3).join(", ")}</span>
              {i < school.length - 1 && <span class="school-sep" aria-hidden="true">  /  </span>}
            </span>
          ))}
        </p>
      </div>
    </section>

    <section class="band" aria-labelledby="exp-title">
      <div class="band-inner">
        <div class="band-col">
          <h2 id="exp-title" class="band-title">Experience</h2>
          <ol class="roles">
            {careers.map((e) => (
              <li>
                <p class="role-when">{e.date}</p>
                <p class="role-title"><a href={`#${e.slug}`} data-select={e.slug}>{e.title}</a></p>
                <p class="role-line">{e.tagline}</p>
                <ul class="role-tech" aria-label="Stack">{allTech(e).map((t) => <li class="tag">{t}</li>)}</ul>
              </li>
            ))}
          </ol>
          <p class="band-foot"><a class="link-pill" href="/Colby-Baker-Resume.pdf">Full resume (PDF)<Icon name="file" size={13} /></a></p>
        </div>
        <div class="band-col">
          <h2 class="band-title">Skills</h2>
          <dl class="skills">
            {skills.map((g) => (
              <div class="tech-row">
                <dt>{g.label}</dt>
                <dd>{g.items.map((i) => <span class="tag">{i}</span>)}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <p><strong>Colby Baker</strong> · Seattle, WA</p>
        <p class="footer-about">Every preview on this page is the real thing: Aspicio is the production site, and the older apps are restored to run their original code in the browser.</p>
      </div>
      <p class="footer-links">
        <a href="https://github.com/Colbyco" rel="me">GitHub</a>
        <a href="https://www.linkedin.com/in/bakercolby/" rel="me">LinkedIn</a>
        <a href="/Colby-Baker-Resume.pdf">Resume</a>
        <a href="https://github.com/Colbyco/portfolio-dsh">Site source</a>
      </p>
    </div>
  </footer>

  <script type="application/json" id="stage-data" set:html={JSON.stringify(stageData)} />
  <script>
    import "../scripts/theater.ts";
  </script>
</Base>
